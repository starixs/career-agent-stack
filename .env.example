# 模型接入：任选其一。优先 ANTHROPIC_*；国内交付可用 OpenAI 兼容接口。
# 壳（app/shell）的内置模型走 DeepSeek 的 Anthropic 兼容原生协议（不经翻译层）：
# 侧车把 CAREER_LLM_BASE_URL 作为 ANTHROPIC_BASE_URL、CAREER_LLM_API_KEY 作为 ANTHROPIC_AUTH_TOKEN 交给 Agent SDK。
CAREER_LLM_API_KEY=
CAREER_LLM_BASE_URL=https://api.deepseek.com/anthropic
CAREER_LLM_MODEL=deepseek-flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
# 本地数据
CAREER_DATA_DIR=./data
# Python 模块桥接（可选）
TRIDENT_BASE_URL=http://127.0.0.1:8686
INTEL_COMPASS_BASE_URL=http://127.0.0.1:8765
DOCPARSE_BIN=docparse
PYTHON_BIN=python3
