[
  { "text": "慢一点没关系，方向对就好。", "tone": "encourage", "scenes": ["daily"] },
  { "text": "先做完一件小事，就已经很好了。", "tone": "encourage", "scenes": ["daily"] },
  { "text": "今天投出去的每一份，都在替你敲门。", "tone": "encourage", "scenes": ["daily"] },
  { "text": "长风破浪会有时，直挂云帆济沧海。", "by": "李白《行路难》", "tone": "humanist", "scenes": ["daily"] },
  { "text": "千淘万漉虽辛苦，吹尽狂沙始到金。", "by": "刘禹锡《浪淘沙》", "tone": "humanist", "scenes": ["daily"] },
  { "text": "路漫漫其修远兮，吾将上下而求索。", "by": "屈原《离骚》", "tone": "humanist", "scenes": ["daily"] },
  { "text": "莫听穿林打叶声，何妨吟啸且徐行。", "by": "苏轼《定风波》", "tone": "humanist", "scenes": ["daily", "quiet"] },
  { "text": "今天的事都划掉了，去吃顿好的吧。", "tone": "encourage", "scenes": ["done"] },
  { "text": "做完了，就把今天还给自己。", "tone": "encourage", "scenes": ["done"] },
  { "text": "采菊东篱下，悠然见南山。", "by": "陶渊明《饮酒》", "tone": "humanist", "scenes": ["done", "quiet"] },
  { "text": "歇一歇也算数。", "tone": "encourage", "scenes": ["quiet"] },
  { "text": "行到水穷处，坐看云起时。", "by": "王维《终南别业》", "tone": "humanist", "scenes": ["quiet"] },
  { "text": "人生如逆旅，我亦是行人。", "by": "苏轼《临江仙》", "tone": "humanist", "scenes": ["quiet"] },
  { "text": "被拒绝的是这一次，不是你。", "tone": "encourage", "scenes": ["setback"] },
  { "text": "沉默不是答案，只是还没轮到你。", "tone": "encourage", "scenes": ["setback"] },
  { "text": "回首向来萧瑟处，也无风雨也无晴。", "by": "苏轼《定风波》", "tone": "humanist", "scenes": ["setback"] },
  { "text": "沉舟侧畔千帆过，病树前头万木春。", "by": "刘禹锡《酬乐天扬州初逢席上见赠》", "tone": "humanist", "scenes": ["setback"] },
  { "text": "山重水复疑无路，柳暗花明又一村。", "by": "陆游《游山西村》", "tone": "humanist", "scenes": ["setback"] },
  { "text": "第一步最难，你已经站在门口了。", "tone": "encourage", "scenes": ["start"] },
  { "text": "莫愁前路无知己，天下谁人不识君。", "by": "高适《别董大》", "tone": "humanist", "scenes": ["start"] },
  { "text": "走的人多了，也便成了路。", "by": "鲁迅《故乡》", "tone": "humanist", "scenes": ["start"] },
  { "text": "千里之行，始于足下。", "by": "老子《道德经》", "tone": "humanist", "scenes": ["funnel-start"] },
  { "text": "长风破浪会有时。", "by": "李白《行路难》", "tone": "humanist", "scenes": ["funnel-start"] },
  { "text": "莫愁前路无知己。", "by": "高适《别董大》", "tone": "humanist", "scenes": ["funnel-start"] },
  { "text": "路漫漫其修远兮。", "by": "屈原《离骚》", "tone": "humanist", "scenes": ["funnel-start"] },
  { "text": "大鹏一日同风起。", "by": "李白《上李邕》", "tone": "humanist", "scenes": ["funnel-start"] },
  { "text": "迷茫的时候，先让自己静下来。", "tone": "encourage", "scenes": ["funnel-start"] },
  { "text": "心有所向，身有所行。", "tone": "encourage", "scenes": ["funnel-start"] },
  { "text": "最大的错，就是什么都不做。", "tone": "encourage", "scenes": ["funnel-start"] },
  { "text": "人生正道是大木参天。", "tone": "encourage", "scenes": ["funnel-start"] },
  { "text": "向前！向前！向前！", "tone": "encourage", "scenes": ["funnel-start"] },
  { "text": "行到水穷处，坐看云起时。", "by": "王维《终南别业》", "tone": "humanist", "scenes": ["funnel-waiting"] },
  { "text": "莫听穿林打叶声。", "by": "苏轼《定风波》", "tone": "humanist", "scenes": ["funnel-waiting"] },
  { "text": "不畏浮云遮望眼。", "by": "王安石《登飞来峰》", "tone": "humanist", "scenes": ["funnel-waiting"] },
  { "text": "采菊东篱下，悠然见南山。", "by": "陶渊明《饮酒》", "tone": "humanist", "scenes": ["funnel-waiting"] },
  { "text": "欲速则不达。", "by": "《论语》", "tone": "humanist", "scenes": ["funnel-waiting"] },
  { "text": "物来则应，物去不随。", "tone": "encourage", "scenes": ["funnel-waiting"] },
  { "text": "迷雾照破，前路并无危险。", "tone": "encourage", "scenes": ["funnel-waiting"] },
  { "text": "时运流转，大势将至。", "tone": "encourage", "scenes": ["funnel-waiting"] },
  { "text": "内功绵长者胜。", "tone": "encourage", "scenes": ["funnel-waiting"] },
  { "text": "心在此处，不在他处。", "tone": "encourage", "scenes": ["funnel-waiting"] },
  { "text": "天生我材必有用。", "by": "李白《将进酒》", "tone": "humanist", "scenes": ["funnel-setback"] },
  { "text": "沉舟侧畔千帆过。", "by": "刘禹锡《酬乐天扬州初逢席上见赠》", "tone": "humanist", "scenes": ["funnel-setback"] },
  { "text": "柳暗花明又一村。", "by": "陆游《游山西村》", "tone": "humanist", "scenes": ["funnel-setback"] },
  { "text": "一蓑烟雨任平生。", "by": "苏轼《定风波》", "tone": "humanist", "scenes": ["funnel-setback"] },
  { "text": "千磨万击还坚劲。", "by": "郑燮《竹石》", "tone": "humanist", "scenes": ["funnel-setback"] },
  { "text": "东隅已逝，桑榆非晚。", "by": "王勃《滕王阁序》", "tone": "humanist", "scenes": ["funnel-setback"] },
  { "text": "心平气和，再战一次。", "tone": "encourage", "scenes": ["funnel-setback"] },
  { "text": "障碍并不必然代表失败。", "tone": "encourage", "scenes": ["funnel-setback"] },
  { "text": "我给你一只手，要你站起来。", "tone": "encourage", "scenes": ["funnel-setback"] },
  { "text": "此刻我能看见，此刻我愿新生。", "tone": "encourage", "scenes": ["funnel-setback"] },
  { "text": "幻境消散，此处不需留恋。", "tone": "encourage", "scenes": ["funnel-setback"] },
  { "text": "彻夜难眠，也可以是天赋。", "tone": "encourage", "scenes": ["funnel-setback"] },
  { "text": "宝剑锋从磨砺出。", "by": "《警世贤文》", "tone": "humanist", "scenes": ["funnel-interview"] },
  { "text": "欲穷千里目，更上一层楼。", "by": "王之涣《登鹳雀楼》", "tone": "humanist", "scenes": ["funnel-interview"] },
  { "text": "不积跬步，无以至千里。", "by": "荀子《劝学》", "tone": "humanist", "scenes": ["funnel-interview"] },
  { "text": "会当凌绝顶，一览众山小。", "by": "杜甫《望岳》", "tone": "humanist", "scenes": ["funnel-interview"] },
  { "text": "我先定下我是谁。", "tone": "encourage", "scenes": ["funnel-interview"] },
  { "text": "身份一定，万物向此奔袭。", "tone": "encourage", "scenes": ["funnel-interview"] },
  { "text": "点亮勇敢之心。", "tone": "encourage", "scenes": ["funnel-interview"] },
  { "text": "心力无穷，能力即无穷。", "tone": "encourage", "scenes": ["funnel-interview"] },
  { "text": "以心为灯，照破一切迷雾。", "tone": "encourage", "scenes": ["funnel-interview"] },
  { "text": "我破它失败恐惧。", "tone": "encourage", "scenes": ["funnel-interview"] },
  { "text": "轻舟已过万重山。", "by": "李白《早发白帝城》", "tone": "humanist", "scenes": ["funnel-offer"] },
  { "text": "春风得意马蹄疾。", "by": "孟郊《登科后》", "tone": "humanist", "scenes": ["funnel-offer"] },
  { "text": "直挂云帆济沧海。", "by": "李白《行路难》", "tone": "humanist", "scenes": ["funnel-offer"] },
  { "text": "吹尽狂沙始到金。", "by": "刘禹锡《浪淘沙》", "tone": "humanist", "scenes": ["funnel-offer"] },
  { "text": "一日看尽长安花。", "by": "孟郊《登科后》", "tone": "humanist", "scenes": ["funnel-offer"] },
  { "text": "我定我万福生花。", "tone": "encourage", "scenes": ["funnel-offer"] },
  { "text": "我定我明灯璀璨。", "tone": "encourage", "scenes": ["funnel-offer"] },
  { "text": "我定我游龙脱困。", "tone": "encourage", "scenes": ["funnel-offer"] },
  { "text": "山门已开，步履光明。", "tone": "encourage", "scenes": ["funnel-offer"] },
  { "text": "此刻燃灯，能让未来放射光芒。", "tone": "encourage", "scenes": ["funnel-offer"] }
]
