{
  "name": "@career/resume-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "简历工作台的文档侧：resume-studio 的数据模型（Zod 4）、15 套 react-pdf 模板、样式规则与字体，从 modules/resume-studio 归档代码引入。",
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./browser": {
      "types": "./dist/pdf/browser.d.ts",
      "import": "./dist/pdf/browser.js"
    },
    "./server": {
      "types": "./dist/pdf/server.d.ts",
      "import": "./dist/pdf/server.js"
    },
    "./document": {
      "types": "./dist/pdf/document.d.ts",
      "import": "./dist/pdf/document.js"
    },
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bramus/specificity": "^2.4.2",
    "@react-pdf/hyphenate": "0.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/stylesheet": "^6.3.2",
    "cjk-regex": "^3.5.0",
    "css-tree": "^3.2.1",
    "fast-png": "^8.0.0",
    "node-html-parser": "^9.0.4",
    "phosphor-icons-react-pdf": "^0.1.3",
    "react-pdf-html": "^2.1.5",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@react-pdf/types": "^2.14.0",
    "@types/css-tree": "^2.3.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
